{
  "expo": {
    "name": "Kompendium",
    "slug": "kompendium",
    "version": "1.0.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "scheme": "kompendium",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0E1012",
    "android": {
      "package": "de.boege.kompendium",
      "versionCode": 1,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0E1012"
      }
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "de.boege.kompendium"
    },
    "plugins": [
      "expo-router",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cfa24936-9f38-4dc5-8076-0e106a7254f6"
      }
    },
    "owner": "boegedev"
  }
}
