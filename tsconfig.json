{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // `src/data/detect.ts` wird auch von `scripts/upload.mjs` geladen, und Node
    // loest nur vollstaendige Dateinamen auf. Der Import dort traegt deshalb
    // seine Endung; Metro findet die Datei genauso.
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": ["./src/*"],
      // Laufzeit laedt die Icons einzeln ueber den Unterpfad (kleines Bundle);
      // TypeScript nimmt dafuer die mitgelieferten Deklarationen, damit nicht
      // der Quellcode des Pakets mitgeprueft wird.
      "phosphor-react-native/src/icons/*": [
        "./node_modules/phosphor-react-native/lib/typescript/icons/*"
      ]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "exclude": ["node_modules"]
}
